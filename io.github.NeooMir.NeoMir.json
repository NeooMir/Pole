{
  "app-id": "io.github.NeooMir.NeoMir",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "neomir",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--talk-name=org.freedesktop.portal.*"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/neomir/cargo"
    }
  },
  "modules": [
    {
      "name": "neomir",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/NeooMir/NeoMir",
          "tag": "v1.2",
          "commit": "6a7d7334674f0fc40e00f5ae649bd00348e62f60"
        },
        "cargo-sources.json"
      ]
    }
  ]
}