<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.NeooMir.Pole</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-or-later</project_license>
  <name>Pole</name>
  <name xml:lang="ru">Поле</name>
  <summary>Educational programming environment for KuMir with Robot performer</summary>
  <summary xml:lang="ru">Среда учебного программирования Поле (КуМир / Исполнитель Робот)</summary>
  <url type="homepage">https://github.com/NeooMir/Pole</url>
  <url type="bugtracker">https://github.com/NeooMir/Pole/issues</url>
  <url type="vcs-browser">https://github.com/NeooMir/Pole</url>
  <developer id="io.github.NeooMir">
    <name>Pole Contributors</name>
  </developer>
  <description>
    <p>
      Pole is a modern educational programming environment based on the KuMir algorithmic language
      and the Robot performer, built with Rust, GTK4, and Libadwaita.
    </p>
    <p xml:lang="ru">
      Поле — современная среда учебного программирования на алгоритмическом языке КуМир
      с Исполнителем «Робот» и «Черепаха», написанная на Rust с использованием GTK4 и Libadwaita.
    </p>
  </description>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/NeooMir/Pole/main/data/screenshot.png</image>
      <caption>Pole IDE with Robot Field and Editor</caption>
      <caption xml:lang="ru">Среда Поле с полем Робота и редактором</caption>
    </screenshot>
  </screenshots>
  <launchable type="desktop-id">io.github.NeooMir.Pole.desktop</launchable>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="1.3.0" date="2026-10-12">
      <description>
        <p>Release 1.3.0: Renamed to Pole, added integrated Turtle performer, GNOME HIG icons, Python integration, multi-language support (RU/EN), and UI performance improvements.</p>
        <p xml:lang="ru">Релиз 1.3.0: Проект переименован в «Поле», добавлен встроенный исполнитель Черепаха, обновлённые иконки по GNOME HIG, поддержка Python, многоязычный интерфейс (RU/EN) и улучшенная производительность.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-09-29">
      <description>
        <p>Initial release under GNU GPLv2: Robot performer, KuMir language VM, syntax themes, and Vim mode.</p>
        <p xml:lang="ru">Первый релиз под лицензией GNU GPLv2: исполнитель Робот, интерпретатор языка КуМир, темы оформления и Vim-режим.</p>
      </description>
    </release>
  </releases>
</component>
