<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.NeooMir.Pole</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Pole</name>
  <name xml:lang="ru">Поле</name>
  <summary>Educational programming environment for KuMir with Robot performer</summary>
  <summary xml:lang="ru">Среда учебного программирования Поле (КуМир / Исполнитель Робот)</summary>
  <url type="homepage">https://github.com/NeooMir/Pole</url>
  <url type="bugtracker">https://github.com/NeooMir/Pole/issues</url>
  <url type="vcs-browser">https://github.com/NeooMir/Pole</url>
  <developer id="io.github.neoomir">
    <name>Pole Contributors</name>
  </developer>
  <description>
    <p>
      Pole is a modern educational programming environment based on the KuMir algorithmic language
      and the Robot performer, built with Rust, GTK4, and Libadwaita.
    </p>
    <p xml:lang="ru">
      Поле — современная среда учебного программирования на алгоритмическом языке КуМир
      с Исполнителем «Робот» и «Черепаха», написанная на Rust с использованием GTK4 и Libadwaita.
    </p>
  </description>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/NeooMir/Pole/main/data/screenshots/editor-robot.png</image>
      <caption>Pole IDE with Robot Field and Editor</caption>
      <caption xml:lang="ru">Среда Поле с полем Робота и редактором</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/NeooMir/Pole/main/data/screenshots/welcome.png</image>
      <caption>Welcome screen with project creation and language selection</caption>
      <caption xml:lang="ru">Главный экран с созданием проекта и выбором языка</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/NeooMir/Pole/main/data/screenshots/blocks.png</image>
      <caption>Visual Scratch-like programming blocks</caption>
      <caption xml:lang="ru">Визуальные блоки программирования Scratch</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/NeooMir/Pole/main/data/screenshots/execution.png</image>
      <caption>Interactive algorithm execution with real-time values</caption>
      <caption xml:lang="ru">Пошаговое выполнение алгоритма с полями значений</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/NeooMir/Pole/main/data/screenshots/settings.png</image>
      <caption>Settings dialog with themes, keyboard shortcuts, and plugins</caption>
      <caption xml:lang="ru">Окно настроек с темами оформления, горячими клавишами и модулями</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/NeooMir/Pole/main/data/screenshots/docs.png</image>
      <caption>Interactive KuMir language and performer reference documentation</caption>
      <caption xml:lang="ru">Интерактивная справка по языку КуМир и исполнителям</caption>
    </screenshot>
  </screenshots>
  <launchable type="desktop-id">io.github.NeooMir.Pole.desktop</launchable>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="1.3.0" date="2026-11-10">
      <description>
        <p>Release 1.3.0: Welcome screen with project creation, integrated Turtle performer, GNOME HIG icons, Python IPC integration, multi-language support (RU/EN), and UI performance improvements.</p>
        <p xml:lang="ru">Релиз 1.3.0: Главный экран с созданием проекта и выбором языка, встроенный исполнитель Черепаха, обновлённые иконки по GNOME HIG, интеграция Python по IPC, многоязычный интерфейс (RU/EN) и улучшенная производительность.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-09-29">
      <description>
        <p>Initial release: Robot performer, KuMir language VM, syntax themes, and Vim mode.</p>
        <p xml:lang="ru">Первый релиз: исполнитель Робот, интерпретатор языка КуМир, темы оформления и Vim-режим.</p>
      </description>
    </release>
  </releases>
</component>
